#!/usr/bin/env bash
# middle-management plugin — one-command git worktrees for the checkouts listed in
# the plugin config (<config dir>/middle-management.json, key protectedCheckouts).
# Consumers: commands/wt.md (the /wt slash command), the deny message of
#   hooks/protect-main-checkouts.sh, and users calling it directly.
#
# Usage:
#   wt <name> new <topic>    worktree <worktreeDir>/<topic>, branch <topic> off <base>
#   wt <name> list           list the checkout's worktrees
#   wt <name> done <topic>   remove the worktree (refuses if dirty or unpushed) and
#                            delete its branch once it is merged into <base>
#
# One lane = one branch = one small pull request. <name>, root, base, install
# command and worktree directory all come from the config; create or change it
# with /middle-management-setup. worktreeDir defaults to the sibling directory
# <parent of root>/.worktrees-<name>.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
CHECK="$HERE/config-check.sh"

die() { echo "wt: $*" >&2; exit 1; }

NAME="${1:-}"; CMD="${2:-}"; TOPIC="${3:-}"
[ -n "$NAME" ] && [ -n "$CMD" ] || die "usage: wt <name> <new|list|done> [topic]"

RC=0; bash "$CHECK" validate || RC=$?
CFGFILE="$(bash "$CHECK" file)"
case "$RC" in
  0) ;;
  1) die "the middle-management config $CFGFILE is invalid — fix it with /middle-management-setup" ;;
  2) die "no middle-management config yet ($CFGFILE) — create one with /middle-management-setup" ;;
  3) die "jq is not installed — wt needs it to read $CFGFILE" ;;
  *) die "config check failed with status $RC" ;;
esac

ENTRY="$(jq -c --arg n "$NAME" 'first((.protectedCheckouts // [])[] | select(.name == $n)) // empty' "$CFGFILE")"
[ -n "$ENTRY" ] || die "no checkout named '$NAME' in $CFGFILE (configured: $(jq -r '[(.protectedCheckouts // [])[].name] | join(", ")' "$CFGFILE")) — add it with /middle-management-setup"

ROOT="$(printf '%s' "$ENTRY" | jq -r '.root')"; ROOT="${ROOT%/}"
BASE="$(printf '%s' "$ENTRY" | jq -r '.base // ""')"
INSTALL="$(printf '%s' "$ENTRY" | jq -r '.install // ""')"
WTDIR="$(printf '%s' "$ENTRY" | jq -r '.worktreeDir // ""')"
[ -n "$WTDIR" ] || WTDIR="$(dirname "$ROOT")/.worktrees-$NAME"
WTDIR="${WTDIR%/}"

git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 \
  || die "the root of checkout '$NAME' is not a git repository: $ROOT — fix it with /middle-management-setup"

check_base() {
  [ -n "$BASE" ] || die "checkout '$NAME' has no base branch configured — set it with /middle-management-setup"
  git -C "$ROOT" rev-parse --verify --quiet "$BASE^{commit}" >/dev/null \
    || die "base '$BASE' of checkout '$NAME' does not resolve to a commit in $ROOT — fix it with /middle-management-setup"
}

case "$CMD" in
  new)
    [ -n "$TOPIC" ] || die "topic missing: wt $NAME new <topic>"
    DEST="$WTDIR/${TOPIC//\//-}"
    [ -e "$DEST" ] && die "$DEST already exists (wt $NAME done '$TOPIC' first?)"
    git -C "$ROOT" remote get-url origin >/dev/null 2>&1 && git -C "$ROOT" fetch origin --quiet
    check_base
    git -C "$ROOT" worktree add "$DEST" -b "$TOPIC" "$BASE"
    if [ -n "$INSTALL" ]; then
      ( cd "$DEST" && sh -c "$INSTALL" >/dev/null 2>&1 ) \
        || echo "wt: WARNING — '$INSTALL' failed, run it manually in $DEST" >&2
    fi
    echo "worktree ready: $DEST  (branch $TOPIC, base $BASE)"
    echo "dev server:     run it on its own port if needed — the main checkout keeps its own"
    echo "session access: if this session cannot edit outside its working directory, add the worktree with /add-dir or start a session there"
    echo "when merged:    wt $NAME done '$TOPIC'"
    ;;
  list)
    git -C "$ROOT" worktree list
    ;;
  done)
    [ -n "$TOPIC" ] || die "topic missing: wt $NAME done <topic>"
    check_base
    DEST="$WTDIR/${TOPIC//\//-}"
    # idempotent: cleanup routines call `done` on lanes that may already be gone
    if [ ! -d "$DEST" ]; then
      git -C "$ROOT" worktree prune 2>/dev/null || true
      echo "already removed: $DEST (nothing to do)"
      exit 0
    fi
    # A cwd inside the worktree survives its removal as a "(deleted)" path and breaks every
    # later command in that shell.
    # ponytail: only THIS shell's cwd — scanning every process for it needs /proc and buys
    # little, since the caller's own shell is the case that actually happens.
    case "$PWD/" in "$DEST"/*) die "your shell's cwd is inside $DEST — cd out of it first (e.g. cd $ROOT), then retry" ;; esac
    # Real branch: <topic> may be the dir name (sec-step0 vs sec/step0). NOT `rev-parse
    # --abbrev-ref` and NOT `symbolic-ref --short`: both shorten to the shortest UNAMBIGUOUS name,
    # so a tag of the same name turns the branch into "heads/<name>" and every later
    # refs/heads/<branch> becomes refs/heads/heads/<name>. Take the full ref and strip the prefix
    # ourselves; empty means detached HEAD.
    BRANCH=$(git -C "$DEST" symbolic-ref -q HEAD 2>/dev/null || true); BRANCH=${BRANCH#refs/heads/}
    [ -z "$(git -C "$DEST" status --porcelain)" ] || die "$DEST has uncommitted changes — commit, stash or clean up first"
    # refuse to drop commits that exist nowhere else
    MERGED=""
    if git -C "$DEST" merge-base --is-ancestor HEAD "$BASE" 2>/dev/null; then
      MERGED=1
    else
      git -C "$DEST" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1 \
        && [ -z "$(git -C "$DEST" log '@{upstream}..HEAD' --oneline)" ] \
        || die "branch ${BRANCH:-<detached HEAD>} has commits that are neither on $BASE nor pushed — push or merge first"
    fi
    # Tip from the WORKTREE, not the root checkout: the root resolves a bare name with tags
    # taking precedence over heads, and on a detached worktree it would print the root's own HEAD.
    TIP=$(git -C "$DEST" rev-parse HEAD 2>/dev/null || true)
    git -C "$ROOT" worktree remove --force "$DEST"
    echo "removed $DEST"
    # Deleting the branch of merged work is cleanup, not destruction — but `git branch -D` is
    # deny-listed in careful setups and `branch -d` refuses squash-merged branches. So: record
    # the tip, make sure no other worktree still has the branch checked out, then update-ref -d
    # with the expected old value, which makes the delete atomic and prints the way back.
    if [ -z "$BRANCH" ]; then
      echo "no branch to delete — $DEST was on a detached HEAD (tip $TIP)"
    elif [ -z "$MERGED" ]; then
      echo "branch $BRANCH kept — it is not merged into $BASE yet. Delete it after the merge with:"
      echo "  git -C $ROOT update-ref -d refs/heads/$BRANCH   # tip is $TIP, restore with: git -C $ROOT branch $BRANCH $TIP"
    else
      # a failure to list must KEEP the branch, never fall through to the delete
      WTL=$(git -C "$ROOT" worktree list --porcelain) \
        || die "cannot list worktrees — branch $BRANCH kept (merged), tip $TIP"
      if grep -qxF "branch refs/heads/$BRANCH" <<<"$WTL"; then
        echo "branch $BRANCH kept — it is merged into $BASE, but another worktree still has it checked out"
      else
        git -C "$ROOT" update-ref -d "refs/heads/$BRANCH" "$TIP"
        echo "branch $BRANCH deleted (merged into $BASE), tip was $TIP — restore with: git -C $ROOT branch $BRANCH $TIP"
      fi
    fi
    ;;
  *) die "usage: wt <name> <new|list|done> [topic]" ;;
esac
