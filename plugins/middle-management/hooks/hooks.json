{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-role.sh\"",
            "timeout": 10,
            "statusMessage": "middle-management: session role"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/protect-main-checkouts.sh\"",
            "timeout": 10,
            "statusMessage": "middle-management: worktree rule"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block-blanket-git-add.sh\"",
            "timeout": 10,
            "statusMessage": "middle-management: staging scope"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/long-running-as-unit.sh\"",
            "timeout": 10,
            "statusMessage": "middle-management: long-runners as units"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/require-review-loop.sh\"",
            "timeout": 10,
            "statusMessage": "middle-management: review gate"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/require-work-packages.sh\"",
            "timeout": 10,
            "statusMessage": "middle-management: work packages"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-report-check.sh\"",
            "timeout": 15,
            "statusMessage": "middle-management: sub-agent report"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/t3-report.sh\"",
            "timeout": 10,
            "statusMessage": "middle-management: T3 report"
          }
        ]
      }
    ]
  }
}
