# middle-management plugin: USER unit template. /middle-management-setup step 10 installs it into
# ~/.config/systemd/user/, then:
#   systemctl --user enable --now mm-pr-review.timer
[Unit]
Description=middle-management: PR review runner - tick every 15 minutes

[Timer]
OnCalendar=*:07/15
Persistent=true
Unit=mm-pr-review.service

[Install]
WantedBy=timers.target
