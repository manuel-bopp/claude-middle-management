# middle-management plugin: USER unit template, started by orch-morning-watchdog.timer, never
# enabled itself. One check (scripts/morning-t3.sh --check): did a coordinator claim the seat and
# stamp the morning ritual today? If not, it fails with its cause on file and the OnFailure= alarm
# sends it (with the notifyFallbackCommand route). /middle-management-setup step 7b installs it.
[Unit]
Description=middle-management: morning watchdog - was the seat claimed and the ritual run today?
OnFailure=unit-failure-alarm@%n.service

[Service]
Type=oneshot
Environment=CLAUDE_CONFIG_DIR=__CONFIG_DIR__
Environment=PATH=__PATH__
Environment=MM_MORNING_UNIT=%n
ExecStart=__MORNING_DIR__/morning-t3.sh --check
TimeoutStartSec=2min
